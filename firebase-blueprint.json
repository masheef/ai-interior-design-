{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "DesignConcept": {
      "title": "Interior Design Concept",
      "description": "A generated interior design recommendation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "roomType": { "type": "string" },
        "width": { "type": "string" },
        "length": { "type": "string" },
        "style": { "type": "string" },
        "budget": { "type": "string" },
        "color": { "type": "string" },
        "roomImage": { "type": "string" },
        "area": { "type": "number" },
        "furniture": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "placement": { "type": "string" }
            }
          }
        },
        "colors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "insights": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "roomType", "area", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Individual user profile documents"
    },
    "designs/{designId}": {
      "schema": "DesignConcept",
      "description": "Collection of all design concepts generated by users"
    }
  }
}
